<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>تطبيق تحويل الأموال</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Cairo', sans-serif;
        }

        body {
            background-color: #111315;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
        }

        /* محاكاة شاشة الهاتف */
        .phone-screen {
            width: 100%;
            max-width: 400px;
            height: 800px;
            background-color: #ffffff;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        /* شريط الحالة العلوي (الساعة والشبكة) */
        .status-bar {
            height: 28px;
            background-color: #004d5a; /* لون داكن يطابق أعلى الصورة */
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 15px;
            color: #ffffff;
            font-size: 12px;
            font-weight: 600;
        }

        /* الهيدر */
        .header {
            height: 50px;
            background-color: #006b7a;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 20px;
            color: #ffffff;
            font-size: 18px;
            font-weight: 600;
        }

        .header i {
            font-size: 20px;
        }

        /* الخلفية الرمادية الشفافة */
        .overlay-bg {
            flex-grow: 1;
            background-color: #808080;
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        /* النص الرمادي في الخلفية */
        .bg-text {
            position: absolute;
            top: 20px;
            right: 25px;
            color: #333;
            font-size: 16px;
            font-weight: 700;
        }

        .bg-phone {
            position: absolute;
            top: 50px;
            right: 30px;
            color: #333;
            font-size: 20px;
            font-weight: 700;
        }

        .bg-phone i {
            font-size: 24px;
            margin-right: 10px;
            vertical-align: middle;
        }

        /* المربع الأبيض المنبثق (الوصل) */
        .receipt-modal {
            width: 90%;
            background-color: #ffffff;
            border-radius: 2px;
            position: relative;
            z-index: 10;
            display: flex;
            flex-direction: column;
            box-shadow: 0 4px 20px rgba(0,0,0,0.2);
        }

        .receipt-content {
            padding: 25px 15px 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .receipt-title {
            font-size: 18px;
            font-weight: 700;
            color: #111315;
            margin-bottom: 15px;
        }

        /* علامة الصح الخضراء */
        .check-icon {
            width: 70px;
            height: 70px;
            margin-bottom: 15px;
            display: block;
        }

        /* نصوص الوصل */
        .receipt-info {
            font-size: 15px;
            font-weight: 700;
            color: #111315;
            line-height: 1.8;
            margin-bottom: 20px;
        }

        .receipt-info span {
            font-weight: 700;
        }

        .info-block {
            width: 100%;
            text-align: right;
            padding: 0 10px;
            margin-bottom: 5px;
        }

        .info-label {
            font-size: 15px;
            font-weight: 700;
            color: #111315;
            display: block;
        }

        .info-value {
            font-size: 15px;
            font-weight: 700;
            color: #111315;
            display: block;
            direction: ltr;
            text-align: right;
        }

        /* النجمة والمفضلة */
        .fav-row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-top: 25px;
            font-size: 14px;
            font-weight: 700;
            color: #111315;
            cursor: pointer;
        }

        .fav-row i {
            font-size: 22px;
            color: #808080; /* رمادي داكن */
        }

        /* زر تم */
        .btn-done {
            width: 100%;
            height: 55px;
            background-color: #00bcd4;
            color: #ffffff;
            border: none;
            font-size: 18px;
            font-weight: 600;
            cursor: pointer;
            border-radius: 0 0 2px 2px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* الشريط السفلي للهاتف */
        .bottom-nav {
            height: 40px;
            background-color: #a88b45;
            display: flex;
            justify-content: center;
            align-items: center;
            color: #ffffff;
            font-size: 16px;
        }

        /* الساعة والموقت */
        .time-stamp {
            position: absolute;
            top: 30px;
            right: 15px;
            color: #333;
            font-size: 14px;
            font-weight: 700;
            direction: ltr;
        }

    </style>
</head>
<body>

    <div class="phone-screen">
        <!-- شريط الحالة -->
        <div class="status-bar">
            <span>12:07</span>
            <span><i class="fa-solid fa-signal"></i> <i class="fa-solid fa-wifi"></i> <i class="fa-solid fa-battery-full"></i></span>
        </div>

        <!-- الهيدر -->
        <div class="header">
            <i class="fa-solid fa-arrow-right"></i>
            <span>تأكيد تحويل الأموال</span>
            <span></span>
        </div>

        <!-- الخلفية الرمادية -->
        <div class="overlay-bg">
            
            <!-- نصوص الخلفية -->
            <div class="bg-text">مراجعة التفاصيل المدخلة</div>
            <div class="bg-phone">
                <span>36069139</span> <i class="fa-solid fa-mobile-screen"></i>
            </div>
            
            <!-- الوقت والتاريخ -->
            <div class="time-stamp">12:53:54 26-11-13</div>

            <!-- المربع الأبيض -->
            <div class="receipt-modal">
                <div class="receipt-content">
                    <div class="receipt-title">النقل ناجح!</div>
                    
                    <!-- علامة الصح -->
                    <svg class="check-icon" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="50" cy="50" r="42" stroke="#5cb85c" stroke-width="6" fill="none"/>
                        <path d="M30 50 L45 65 L70 35" stroke="#5cb85c" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                    </svg>

                    <!-- معلومات التحويل -->
                    <div class="receipt-info">
                        المستفيد: 36069139 المبلغ المرسل: 30<br>MRU
                    </div>

                    <!-- معرف المعاملة -->
                    <div class="info-block">
                        <span class="info-label">معرف المعاملة :</span>
                        <span class="info-value">1026111312535260000</span>
                    </div>
                    
                    <!-- التاريخ والوقت -->
                    <div class="info-block">
                        <span class="info-label">التاريخ والوقت :</span>
                        <span class="info-value">12:53:54 26-11-13</span>
                    </div>

                    <!-- المفضلة -->
                    <div class="fav-row">
                        <span>إضافة إلى المفضلة</span>
                        <i class="fa-solid fa-star"></i>
                    </div>
                </div>

                <!-- زر تم -->
                <button class="btn-done">تم</button>
            </div>

        </div>

        <!-- الشريط السفلي -->
        <div class="bottom-nav">
            أنتم
        </div>
    </div>

</body>
</html>
