        <main class="form-content">
            <div class="clean-input-group">
                <label class="clean-label">رقم الهاتف</label>
                <div class="clean-input-row">
                    <input type="tel" id="phoneInput" inputmode="numeric" pattern="[0-9]*" class="clean-input" placeholder="أدخل رقم الهاتف" maxlength="8" autocomplete="off" oninput="this.value = this.value.replace(/\D/g, '')">
                    <i class="fa-solid fa-address-book contacts-book-icon"></i>
                </div>
            </div>

            <div class="clean-input-group">
                <label class="clean-label">المبلغ</label>
                <div class="clean-input-row">
                    <input type="tel" id="amountInput" inputmode="numeric" pattern="[0-9]*" class="clean-input" placeholder="أدخل المبلغ" autocomplete="off" oninput="this.value = this.value.replace(/\D/g, '')">
                </div>
            </div>

            <div class="clean-input-group">
                <label class="clean-label">ملاحظة (اختياري)</label>
                <div class="clean-input-row">
                    <input type="text" id="noteInput" class="clean-input" placeholder="أدخل ملاحظة" autocomplete="off">
                </div>
            </div>
        </main>

        <button type="button" class="bottom-full-btn" onclick="validateAndProceed()">إرسال</button>
    </div>

    <!-- ================= الواجهة 4: تأكيد تحويل الأموال ================= -->
    <div id="page4" class="page">
        <header class="top-header" style="padding-bottom: 12px;">
            <div class="navbar" style="margin-bottom: 0;">
                <i class="fa-solid fa-arrow-right back-icon" onclick="showPage('page3')"></i>
                <h1 class="page-title">تأكيد تحويل الأموال</h1>
            </div>
        </header>

        <div class="page-scrollable-content">
            <div class="review-subtitle">مراجعة التفاصيل المدخلة</div>

            <div class="recipient-row">
                <span id="reviewPhoneDisplay" class="recipient-number"></span>
                <div class="recipient-phone-icon-match"><i class="fa-solid fa-mobile-screen"></i></div>
            </div>

            <div class="review-box-card">
                <div class="review-amount-section">
                    <div class="review-amount-label">المبلغ</div>
                    <div id="reviewAmountDisplay" class="review-amount-val"></div>
                </div>

                <div class="fee-details-title">تفاصيل تكلفة الخدمة</div>

                <div class="fee-row">
                    <span>تكلفة الخدمة</span>
                    <span class="fee-dash">-</span>
                    <span class="fee-val">MRU 0</span>
                </div>
                <div class="fee-row">
                    <span>العمولة</span>
                    <span class="fee-dash">-</span>
                    <span class="fee-val">MRU 0</span>
                </div>
                <div class="fee-row">
                    <span>الضريبة</span>
                    <span class="fee-dash">-</span>
                    <span class="fee-val">MRU 0</span>
                </div>
            </div>
        </div>

        <button type="button" class="bottom-full-btn" onclick="openPinModal()">أتمم</button>
    </div>

    <!-- نافذة الخطأ -->
    <div id="errorModal" class="modal-overlay">
        <div class="error-box">
            <div class="error-title">خطأ</div>
            <div id="errorMessageText" class="error-msg">أدخل رقم هاتف صالح</div>
            <button type="button" class="modal-cyan-btn" onclick="closeErrorModal()">تم</button>
        </div>
    </div>

    <!-- نافذة الرمز السري -->
    <div id="pinModal" class="modal-overlay">
        <div class="pin-box">
            <i class="fa-solid fa-xmark pin-close-btn" onclick="closePinModal()"></i>
            <div class="pin-prompt-text">الرجاء إدخال الرمز السري</div>

            <input type="tel" id="hiddenPinInput" inputmode="numeric" pattern="[0-9]*" style="position: absolute; opacity: 0; pointer-events: none;" maxlength="4" oninput="updatePinDisplay(this.value)">

            <div class="pin-slots" onclick="document.getElementById('hiddenPinInput').focus();">
                <div class="pin-slot" id="d1"></div>
                <div class="pin-slot" id="d2"></div>
                <div class="pin-slot" id="d3"></div>
                <div class="pin-slot" id="d4"></div>
            </div>

            <button type="button" class="modal-cyan-btn" onclick="submitPin()">ارسل الطلب</button>
        </div>
    </div>

    <!-- الوصل النهائي -->
    <div id="successModal" class="modal-overlay">
        <div class="receipt-box">
            <div class="receipt-body">
                <div class="receipt-title">النقل ناجح!</div>
                <div class="receipt-check-circle"><i class="fa-solid fa-check"></i></div>

                <div class="receipt-summary">
                    <div class="summary-top-line">
                        المستفيد: <span id="finalPhone"></span> المبلغ المرسل: <span id="finalAmount"></span>
                    </div>
                    <span class="mru-label">MRU</span>
                </div>

                <div class="receipt-info-block">معرف المعاملة :<br><span id="transactionId" class="transaction-id-value"></span></div>
                <div class="receipt-info-block">التاريخ والوقت : <span id="transactionDateTime"></span></div>

                <div class="receipt-fav-row" onclick="toggleFavorite()">
                    <i class="fa-solid fa-star" id="favStar"></i>
                    <span>إضافة إلى المفضلة</span>
                </div>
            </div>

            <button type="button" class="modal-cyan-btn" onclick="closeSuccessModal()">تم</button>
        </div>
    </div>

    <script>
        function clearFormFields() {
            document.getElementById('phoneInput').value = '';
            document.getElementById('amountInput').value = '';
            document.getElementById('noteInput').value = '';
        }

        function showPage(pageId) {
            document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
            document.getElementById(pageId).classList.add('active');
        }

        function openSendMoneyPage() {
            clearFormFields();
            showPage('page3');
        }

        function showErrorPopup(message) {
            document.getElementById('errorMessageText').innerText = message;
            document.getElementById('errorModal').style.display = 'flex';
        }

        function validateAndProceed() {
            const phone = document.getElementById('phoneInput').value.trim();
            const amount = document.getElementById('amountInput').value.trim();
            const mauritanianPhoneRegex = /^[234]\d{7}$/;

            if (!mauritanianPhoneRegex.test(phone)) {
                showErrorPopup('أدخل رقم هاتف صالح');
                return;
            }

            if (amount === '' || Number(amount) <= 0) {
                showErrorPopup('أدخل مبلغ صالح');
                return;
            }

            document.getElementById('reviewPhoneDisplay').innerText = phone;
            document.getElementById('reviewAmountDisplay').innerText = 'MRU ' + amount;

            showPage('page4');
        }

        function closeErrorModal() {
            document.getElementById('errorModal').style.display = 'none';
        }

        function openPinModal() {
            document.getElementById('hiddenPinInput').value = '';
            updatePinDisplay('');
            document.getElementById('pinModal').style.display = 'flex';
            setTimeout(() => document.getElementById('hiddenPinInput').focus(), 100);
        }

        function closePinModal() {
            document.getElementById('pinModal').style.display = 'none';
        }

        function updatePinDisplay(val) {
            val = val.replace(/\D/g, '').slice(0, 4);
            document.getElementById('hiddenPinInput').value = val;
            for (let i = 1; i <= 4; i++) {
                const slot = document.getElementById('d' + i);
                slot.innerText = i <= val.length ? '•' : '';
            }
        }

        function submitPin() {
            const pin = document.getElementById('hiddenPinInput').value.trim();
            if (pin.length < 4) {
                showErrorPopup('الرجاء إدخال الرمز السري كاملاً (4 أرقام)');
                return;
            }

            closePinModal();

            const phone = document.getElementById('phoneInput').value.trim();
            const amount = document.getElementById('amountInput').value.trim();

            document.getElementById('finalPhone').innerText = phone;
            document.getElementById('finalAmount').innerText = amount;

            let randomTransId = '10261113'; 
            for(let i=0; i<12; i++) {
                randomTransId += Math.floor(Math.random() * 10);
            }
            document.getElementById('transactionId').innerText = randomTransId;

            const now = new Date();
            const hours = String(now.getHours()).padStart(2, '0');
            const minutes = String(now.getMinutes()).padStart(2, '0');
            const seconds = String(now.getSeconds()).padStart(2, '0');
            
            const year = String(now.getFullYear()).slice(-2);
            const month = String(now.getMonth() + 1).padStart(2, '0');
            const day = String(now.getDate()).padStart(2, '0');

            document.getElementById('transactionDateTime').innerText = `${hours}:${minutes}:${seconds} ${year}-${month}-${day}`;
            document.getElementById('favStar').classList.remove('starred');

            document.getElementById('successModal').style.display = 'flex';
        }

        function closeSuccessModal() {
            document.getElementById('successModal').style.display = 'none';
            clearFormFields();
            showPage('page1');
        }

        function toggleFavorite() {
            document.getElementById('favStar').classList.toggle('starred');
        }
    </script>
</body>
