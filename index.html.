<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>تطبيق تحويل الأموال</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=Roboto:wght@400;500;700&family=Noto+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Cairo', sans-serif;
        }

        body {
            background-color: #f3f4f6;
            color: #111315;
            display: flex;
            flex-direction: column;
            height: 100dvh;
            max-height: 100dvh;
            overflow: hidden;
            max-width: 480px;
            margin: 0 auto;
            border-left: 1px solid #e5e7eb;
            border-right: 1px solid #e5e7eb;
            position: relative;
        }

        .page {
            display: none;
            flex-direction: column;
            height: 100%;
            max-height: 100%;
            background-color: #ffffff;
            overflow: hidden;
        }

        .page.active {
            display: flex;
        }

        /* الهيدر العلوي */
        .top-header {
            background-color: #0eb4c2;
            padding: 14px 18px 16px;
            color: #ffffff;
            flex-shrink: 0;
        }

        .navbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 15px;
            position: relative;
        }

        .menu-icon, .back-icon {
            font-size: 22px;
            color: #ffffff;
            cursor: pointer;
            z-index: 2;
        }

        .page-title {
            font-size: 19px;
            font-weight: 600;
            position: absolute;
            left: 0;
            right: 0;
            text-align: center;
            pointer-events: none;
        }

        /* ================= الواجهة 1: لوحة القيادة ================= */
        .top-actions {
            display: flex;
            justify-content: space-around;
            align-items: center;
            text-align: center;
            padding-top: 2px;
        }

        .action-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            color: #ffffff;
            gap: 6px;
            cursor: pointer;
            width: 33.3%;
        }

        .circle-icon {
            width: 48px;
            height: 48px;
            background-color: #0a8d99;
            border: 1.5px solid #c5e063;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .action-item span {
            font-size: 12px;
            font-weight: 600;
        }

        .dashboard-grid {
            padding: 10px 14px;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
            flex-grow: 1;
            align-content: start;
            background-color: #ffffff;
            overflow-y: auto;
        }

        .grid-card {
            background-color: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 3px;
            padding: 12px 6px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: #1f2937;
            gap: 8px;
            min-height: 100px;
            cursor: pointer;
            box-shadow: 0 1px 2px rgba(0,0,0,0.02);
        }

        .grid-card i { font-size: 26px; }

        .gimtel-badge-match {
            width: 38px;
            height: 38px;
            background-color: #0eb4c2;
            color: #ffffff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            font-weight: 700;
            font-family: Arial, sans-serif;
        }

        .grid-card span {
            font-size: 12px;
            font-weight: 600;
            line-height: 1.2;
            color: #374151;
        }

        .bottom-nav {
            background-color: #ffffff;
            border-top: 1px solid #e5e7eb;
            display: flex;
            justify-content: space-around;
            padding: 6px 0;
            margin-top: auto;
            flex-shrink: 0;
        }

        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-decoration: none;
            color: #9ca3af;
            font-size: 11px;
            gap: 3px;
            font-weight: 600;
        }
        .nav-item i { font-size: 17px; }
        .nav-item.active { color: #0eb4c2; }

        /* ================= الواجهة 2: تحويل الأموال ================= */
        .action-buttons-top {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-top: 5px;
        }

        .top-btn {
            background-color: #007b8a;
            border: none;
            border-radius: 4px;
            padding: 14px 10px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 8px;
            color: #ffffff;
            cursor: pointer;
        }
        .top-btn.yellow {
            background-color: #fbc02d;
            color: #ffffff;
        }
        .top-btn span { font-size: 13.5px; font-weight: 600; }

        .grey-divider-bar {
            background-color: #eeeeee;
            padding: 8px;
            text-align: center;
            font-size: 14px;
            font-weight: 600;
            color: #4b5563;
            flex-shrink: 0;
        }

        .qr-center-box {
            padding: 22px 15px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 10px;
            background-color: #ffffff;
            cursor: pointer;
        }

        .board-section {
            padding: 15px 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            background-color: #ffffff;
            flex-grow: 1;
            overflow-y: auto;
        }
        .board-desc {
            font-size: 12.5px;
            color: #6b7280;
            text-align: center;
            margin-bottom: 15px;
        }
        .add-board-box {
            width: 120px;
            height: 110px;
            border: 2px dotted #0eb4c2;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }
        .add-board-box i {
            font-size: 32px;
            color: #0eb4c2;
            font-weight: 300;
        }

        /* ================= الواجهة 3: إرسال الأموال ================= */
        .top-tabs {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            text-align: center;
            margin-top: 14px;
            position: relative;
        }
        .tab-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            color: #ffffff;
            gap: 6px;
            opacity: 0.6;
            cursor: pointer;
            position: relative;
            padding-bottom: 10px;
        }
        .tab-item.active {
            opacity: 1;
        }
        .tab-item.active::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 4px;
            background-color: #ffffff;
        }
        .tab-icon-wrap {
            height: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .tab-item span {
            font-size: 12px;
            font-weight: 600;
        }

        .form-content {
            padding: 18px 20px;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            gap: 16px;
            background-color: #ffffff;
            overflow-y: auto;
        }

        .clean-input-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }
        .clean-label {
            font-size: 13.5px;
            font-weight: 700;
            color: #374151;
            text-align: right;
        }
        .clean-input-row {
            display: flex;
            align-items: center;
            border-bottom: 1.5px solid #9ca3af;
            padding-bottom: 6px;
        }
        .clean-input {
            border: none;
            outline: none;
            width: 100%;
            font-size: 15px;
            color: #111315;
            background: transparent;
            text-align: right;
        }
        .clean-input::placeholder {
            color: #9ca3af;
            font-size: 14px;
        }
        .contacts-book-icon {
            color: #fbc02d;
            font-size: 20px;
            padding-right: 10px;
            cursor: pointer;
        }

        .bottom-full-btn {
            width: 100%;
            background-color: #fbc02d;
            color: #ffffff;
            border: none;
            padding: 14px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            text-align: center;
            flex-shrink: 0;
        }

        /* ================= الواجهة 4: تأكيد تحويل الأموال ================= */
        .page-scrollable-content {
            flex-grow: 1;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
        }

        .review-subtitle {
            text-align: right;
            padding: 14px 20px 8px;
            font-size: 14.5px;
            font-weight: 700;
            color: #374151;
            flex-shrink: 0;
        }

        .recipient-row {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 12px;
            padding: 0 20px 14px;
            direction: ltr;
            flex-shrink: 0;
        }
        .recipient-number {
            font-size: 17px;
            font-weight: 700;
            color: #1f2937;
            letter-spacing: 0.5px;
        }
        .recipient-phone-icon-match {
            width: 38px;
            height: 38px;
            background-color: #2b3137;
            border-radius: 50%;
            color: #9ca3af;
            font-size: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .review-box-card {
            background-color: #f3f4f6;
            margin: 0 15px 15px;
            border-radius: 6px;
            padding: 14px 16px;
            flex-shrink: 0;
        }
        .review-amount-section {
            border-bottom: 1px solid #e5e7eb;
            padding-bottom: 10px;
            margin-bottom: 10px;
            text-align: right;
        }
        .review-amount-label {
            font-size: 13.5px;
            font-weight: 700;
            color: #374151;
            margin-bottom: 4px;
        }
        .review-amount-val {
            font-size: 15px;
            font-weight: 700;
            color: #111315;
            direction: ltr;
            text-align: right;
        }

        .fee-details-title {
            font-size: 13.5px;
            font-weight: 700;
            color: #374151;
            margin-bottom: 10px;
            text-align: right;
        }

        .fee-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 6px 0;
            font-size: 14px;
            color: #374151;
            font-weight: 600;
        }
        .fee-dash {
            color: #6b7280;
        }
        .fee-val {
            direction: ltr;
            font-weight: 700;
            color: #1f2937;
        }

        /* ================= النوافذ المنبثقة ================= */
        .modal-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background-color: rgba(0, 0, 0, 0.65);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            padding: 15px;
        }

        .error-box {
            background-color: #ffffff;
            width: 82%;
            max-width: 310px;
            border-radius: 4px;
            overflow: hidden;
            text-align: center;
            box-shadow: 0 4px 20px rgba(0,0,0,0.2);
        }
        .error-title {
            font-size: 16px;
            font-weight: 700;
            padding: 18px 15px 8px;
            color: #111315;
        }
        .error-msg {
            font-size: 14px;
            color: #4b5563;
            padding: 0 15px 20px;
        }
        .modal-cyan-btn {
            background-color: #00bcd4;
            color: #ffffff;
            border: none;
            width: 100%;
            padding: 15px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            display: block;
            font-family: 'Noto Sans Arabic', sans-serif;
            flex-shrink: 0;
        }

        .pin-box {
            background-color: #ffffff;
            width: 85%;
            max-width: 320px;
            border-radius: 4px;
            overflow: hidden;
            position: relative;
            text-align: center;
            box-shadow: 0 6px 25px rgba(0,0,0,0.25);
        }
        .pin-close-btn {
            position: absolute;
            top: 10px;
            left: 12px;
            font-size: 22px;
            color: #9ca3af;
            cursor: pointer;
            line-height: 1;
        }
        .pin-prompt-text {
            font-size: 15px;
            font-weight: 600;
            color: #374151;
            margin: 35px 15px 25px;
        }
        .pin-slots {
            display: flex;
            justify-content: center;
            gap: 16px;
            margin-bottom: 30px;
            direction: ltr;
            cursor: pointer;
        }
        .pin-slot {
            width: 36px;
            height: 28px;
            border-bottom: 1.5px solid #374151;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 26px;
            color: #111315;
        }

        /* ================= تصميم الوصل ================= */
        .receipt-box {
            background-color: #ffffff;
            width: 88%;
            max-width: 325px;
            border-radius: 4px;
            overflow: hidden;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
            font-family: 'Noto Sans Arabic', 'Cairo', sans-serif;
            display: flex;
            flex-direction: column;
        }
        .receipt-body {
            padding: 22px 18px 16px;
            flex-grow: 1;
        }
        .receipt-title {
            font-size: 17.5px;
            font-weight: 600;
            color: #111111; 
            margin-bottom: 14px;
        }
        .receipt-check-circle {
            width: 65px;
            height: 65px;
            border: 3px solid #4caf50;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 16px;
            color: #4caf50;
            font-size: 32px;
        }
        
        .receipt-summary, 
        .receipt-summary *, 
        #finalPhone, 
        #finalAmount, 
        .mru-label, 
        .receipt-info-block, 
        .receipt-info-block *, 
        .transaction-id-value {
            color: #111111 !important;
            font-family: 'Noto Sans Arabic', 'Roboto', sans-serif !important;
            font-size: 15px !important;
            font-weight: 500 !important;
        }

        .receipt-summary {
            line-height: 1.4;
            margin-bottom: 14px;
            text-align: center;
            direction: rtl;
            display: flex;
            flex-direction: column;
            align-items: center;
            width: 100%;
        }

        .summary-top-line {
            white-space: nowrap; 
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
            width: 100%;
        }

        .mru-label {
            margin-top: 2px;
            letter-spacing: 0.5px;
            display: block;
        }
        
        .receipt-info-block {
            margin-bottom: 6px;
            text-align: center;
            direction: rtl;
            line-height: 1.3;
        }
        .receipt-info-block:last-of-type {
            margin-bottom: 14px;
        }
        .receipt-info-block span {
            unicode-bidi: plaintext;
            direction: ltr;
            display: inline-block;
        }
        
        .transaction-id-value {
            letter-spacing: 0.5px; 
            direction: ltr;
            display: inline-block;
            white-space: nowrap;
            unicode-bidi: plaintext;
        }
        
        .receipt-fav-row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-top: 10px;
            margin-bottom: 0;
            font-size: 14px;
            font-weight: 500;
            color: #4b5563;
            cursor: pointer;
            flex-direction: row;
        }
        .receipt-fav-row i {
            font-size: 18px;
            color: #9ca3af;
            transition: color 0.2s;
        }
        .receipt-fav-row i.starred {
            color: #fbc02d;
        }
    </style>
</head>
<body>

    <!-- ================= الواجهة 1: لوحة القيادة ================= -->
    <div id="page1" class="page active">
        <header class="top-header">
            <div class="navbar">
                <i class="fa-solid fa-bars menu-icon"></i>
                <h1 class="page-title">لوحة القيادة</h1>
            </div>
            <div class="top-actions">
                <div class="action-item">
                    <div class="circle-icon"><i class="fa-solid fa-hand-holding-dollar"></i></div>
                    <span>تسديد مشتريات</span>
                </div>
                <div class="action-item" onclick="showPage('page2')">
                    <div class="circle-icon"><i class="fa-solid fa-money-bill-transfer"></i></div>
                    <span>تحويل الأموال</span>
                </div>
                <div class="action-item">
                    <div class="circle-icon" style="background-color: #0eb4c2; border: 1.5px solid #a3e635; display: flex; align-items: center; justify-content: center;">
                        <svg viewBox="0 0 36 36" width="22" height="22" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="10" y="6" width="16" height="22" rx="2" stroke="#ffffff" stroke-width="2"/>
                            <line x1="14" y1="11" x2="22" y2="11" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round"/>
                            <line x1="14" y1="16" x2="22" y2="16" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round"/>
                            <line x1="14" y1="21" x2="19" y2="21" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round"/>
                        </svg>
                    </div>
                    <span>حسابي</span>
                </div>
            </div>
        </header>

        <main class="dashboard-grid">
            <div class="grid-card">
                <svg viewBox="0 0 40 44" width="34" height="38" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="8" y="3" width="24" height="38" rx="3" stroke="#0eb4c2" stroke-width="2"/>
                    <line x1="17" y1="6.5" x2="23" y2="6.5" stroke="#0eb4c2" stroke-width="1.8" stroke-linecap="round"/>
                    <rect x="11.5" y="10" width="17" height="23.5" stroke="#0eb4c2" stroke-width="1.6"/>
                    <circle cx="20" cy="37.2" r="1.3" fill="#0eb4c2"/>
                    <path d="M20 14L26 20.5H22.6V28.5H17.4V20.5H14L20 14Z" stroke="#0eb4c2" stroke-width="1.7" stroke-linejoin="round"/>
                </svg>
                <span>تعبئة رصيد الهاتف</span>
            </div>
            <div class="grid-card">
                <svg viewBox="0 0 44 44" width="36" height="36" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M11 5H30V31H11" stroke="#facc15" stroke-width="2" stroke-linejoin="round"/>
                    <path d="M11 5V21" stroke="#facc15" stroke-width="2" stroke-linecap="round"/>
                    <rect x="14.5" y="9" width="12" height="4.5" stroke="#facc15" stroke-width="1.7"/>
                    <line x1="19" y1="17.5" x2="26.5" y2="17.5" stroke="#facc15" stroke-width="1.7" stroke-linecap="round"/>
                    <line x1="19" y1="21" x2="26.5" y2="21" stroke="#facc15" stroke-width="1.7" stroke-linecap="round"/>
                    <line x1="19" y1="24.5" x2="26.5" y2="24.5" stroke="#facc15" stroke-width="1.7" stroke-linecap="round"/>
                    <path d="M30 18H36V27.5C36 29.5 34.5 31 32.5 31H29" stroke="#facc15" stroke-width="2" stroke-linejoin="round"/>
                    <path d="M11 20C8.5 21.5 7 24 7 27V38" stroke="#facc15" stroke-width="2" stroke-linecap="round"/>
                </svg>
                <span>تسديد الفواتير</span>
            </div>
            <div class="grid-card">
                <svg viewBox="0 0 44 38" width="38" height="34" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M13 10H33C34.1 10 35 10.9 35 12V28C35 29.1 34.1 30 33 30H13C11.9 30 11 29.1 11 28V12C11 10.9 11.9 10 13 10Z" stroke="#0eb4c2" stroke-width="2"/>
                    <path d="M11 15H35" stroke="#0eb4c2" stroke-width="1.6"/>
                    <line x1="18" y1="19" x2="28" y2="19" stroke="#0eb4c2" stroke-width="1.6" stroke-linecap="round"/>
                    <line x1="18" y1="23" x2="25" y2="23" stroke="#0eb4c2" stroke-width="1.6" stroke-linecap="round"/>
                    <path d="M11 26H15C16.1 26 17 26.9 17 28V31C17 32.1 16.1 33 15 33H11" stroke="#0eb4c2" stroke-width="1.8"/>
                    <path d="M16 6L18 8L16 32L14 32L16 6Z" fill="#0eb4c2"/>
                </svg>
                <span>طلب دفتر شيكات</span>
            </div>
            <div class="grid-card">
                <svg viewBox="0 0 46 36" width="38" height="32" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="3" y="3" width="40" height="30" rx="4" stroke="#facc15" stroke-width="2.2"/>
                    <rect x="26" y="9" width="10" height="8" rx="1.5" stroke="#facc15" stroke-width="1.6"/>
                    <line x1="26" y1="13" x2="36" y2="13" stroke="#facc15" stroke-width="1.4"/>
                    <line x1="31" y1="9" x2="31" y2="17" stroke="#facc15" stroke-width="1.4"/>
                </svg>
                <span>البطاقات البنكية</span>
            </div>
            <div class="grid-card">
                <svg viewBox="0 0 44 42" width="38" height="36" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M5 9H39C40.1 9 41 9.9 41 11V15C41 16.1 40.1 17 39 17H5C3.9 17 3 16.1 3 15V11C3 9.9 3.9 9 5 9Z" stroke="#0eb4c2" stroke-width="2"/>
                    <path d="M16 16V33C16 34.1 16.9 35 18 35H28C29.1 35 30 34.1 30 33V16" stroke="#0eb4c2" stroke-width="1.8"/>
                </svg>
                <span>سحب النقود</span>
            </div>
            <div class="grid-card">
                <svg viewBox="0 0 40 44" width="32" height="36" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="8" y="3" width="24" height="38" rx="3" fill="#facc15"/>
                    <rect x="11" y="7" width="18" height="24" rx="1" fill="#ffffff"/>
                    <circle cx="20" cy="37" r="1.5" fill="#ffffff"/>
