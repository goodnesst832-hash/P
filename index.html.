    <!-- الوصل النهائي المطابق تماماً للصورة الحقيقية -->
    <div id="successModal" class="modal-overlay" style="display: flex;">
        <div class="receipt-box" style="background-color: #ffffff; width: 85%; max-width: 310px; border-radius: 4px; overflow: hidden; text-align: center; box-shadow: 0 10px 25px rgba(0,0,0,0.3); font-family: 'Noto Sans Arabic', 'Cairo', sans-serif; display: flex; flex-direction: column;">
            <div class="receipt-body" style="padding: 20px 18px 14px; flex-grow: 1;">
                
                <div class="receipt-title" style="font-size: 16px; font-weight: 600; color: #111315; margin-bottom: 12px;">النقل ناجح!</div>
                
                <!-- دائرة النجاح متوازنة وسماكة خط طبيعية -->
                <div class="receipt-check-circle" style="width: 52px; height: 52px; border: 2px solid #5cb85c; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 14px; color: #5cb85c; font-size: 24px;">
                    <i class="fa-solid fa-check"></i>
                </div>

                <!-- تفاصيل المستفيد والمبلغ بتنسيق غير متكتل -->
                <div class="receipt-summary" style="font-size: 13.5px; font-weight: 500; color: #333333; line-height: 1.4; margin-bottom: 10px; text-align: center; direction: rtl;">
                    المستفيد: <span id="finalPhone" style="font-weight: 600; color: #111315;"></span> المبلغ المرسل: <span id="finalAmount" style="font-weight: 600; color: #111315;"></span>
                    <span class="mru-label" style="font-size: 13.5px; font-weight: 500; color: #333333; margin-top: 2px; display: block;">MRU</span>
                </div>

                <!-- معرف المعاملة -->
                <div class="receipt-info-block" style="font-size: 13.5px; font-weight: 500; color: #333333; margin-bottom: 8px; text-align: center; direction: rtl; line-height: 1.3;">
                    معرف المعاملة :<br>
                    <span id="transactionId" class="transaction-id-value" style="font-size: 13.5px; font-weight: 500; color: #111315; letter-spacing: 0.3px; direction: ltr; display: inline-block;"></span>
                </div>

                <!-- التاريخ والوقت -->
                <div class="receipt-info-block" style="font-size: 13.5px; font-weight: 500; color: #333333; margin-bottom: 10px; text-align: center; direction: rtl;">
                    التاريخ والوقت : <span id="transactionDateTime" style="font-weight: 500; color: #111315; direction: ltr; display: inline-block;"></span>
                </div>

                <!-- زر المفضلة -->
                <div class="receipt-fav-row" onclick="toggleFavorite()" style="display: flex; align-items: center; justify-content: center; gap: 6px; margin-top: 8px; margin-bottom: 2px; font-size: 13.5px; font-weight: 500; color: #4b5563; cursor: pointer;">
                    <i class="fa-solid fa-star" id="favStar" style="font-size: 16px; color: #9ca3af;"></i>
                    <span>إضافة إلى المفضلة</span>
                </div>
            </div>

            <!-- زر "تم" الفيروزي متناسق ودون التصاق حاد بالخلفية -->
            <button type="button" class="modal-cyan-btn" onclick="closeSuccessModal()" style="background-color: #00bcd4; color: #ffffff; border: none; width: 100%; padding: 14px; font-size: 15px; font-weight: 600; cursor: pointer; display: block; font-family: 'Noto Sans Arabic', sans-serif;">تم</button>
        </div>
    </div>
