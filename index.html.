    <!-- ================= الواجهة 3: إرسال الأموال ================= -->
    <div id="page3" class="page">
        <header class="top-header" style="padding-bottom: 0;">
            <div class="navbar">
                <i class="fa-solid fa-arrow-right back-icon" onclick="showPage('page2')"></i>
                <h1 class="page-title">إرسال الأموال</h1>
            </div>
            <div class="top-tabs">
                <!-- 1. رقم الهاتف -->
                <div class="tab-item active">
                    <div class="tab-icon-wrap">
                        <svg viewBox="0 0 28 34" width="20" height="24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="3" y="2" width="22" height="30" rx="3" fill="#fbc02d"/>
                            <rect x="5" y="5" width="18" height="20" rx="1" fill="#ffffff"/>
                            <circle cx="14" cy="28.5" r="1.2" fill="#ffffff"/>
