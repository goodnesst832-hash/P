<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تطبيق تحويل الأموال</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Cairo', sans-serif;
        }

        body {
            background-color: #f3f4f6;
            color: #111315;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            max-width: 480px;
            margin: 0 auto;
            border-left: 1px solid #e5e7eb;
            border-right: 1px solid #e5e7eb;
            position: relative;
        }

        .page {
            display: none;
            flex-direction: column;
            min-height: 100vh;
            background-color: #ffffff;
        }

        .page.active {
            display: flex;
        }

        /* الهيدر العلوي */
        .top-header {
            background-color: #0eb4c2;
            padding: 16px 18px 22px;
            color: #ffffff;
        }

        .navbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
            position: relative;
        }

        .menu-icon, .back-icon {
            font-size: 22px;
            color: #ffffff;
            cursor: pointer;
            z-index: 2;
        }

        .page-title {
            font-size: 19px;
            font-weight: 600;
            position: absolute;
            left: 0;
            right: 0;
            text-align: center;
            pointer-events: none;
        }

        /* ================= الواجهة 1: لوحة القيادة ================= */
        .top-actions {
            display: flex;
            justify-content: space-around;
            align-items: center;
            text-align: center;
            padding-top: 5px;
        }

        .action-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            color: #ffffff;
            gap: 8px;
            cursor: pointer;
            width: 33.3%;
        }

        .circle-icon-match {
            width: 58px;
            height: 58px;
            background-color: #0ab2bf;
            border: 2px solid #a4df64;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .action-item span {
            font-size: 13px;
            font-weight: 600;
        }

        .dashboard-grid {
            padding: 14px;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            flex-grow: 1;
            align-content: start;
            background-color: #ffffff;
        }

        .grid-card {
            background-color: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 3px;
            padding: 20px 6px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: #1f2937;
            gap: 12px;
            min-height: 120px;
            cursor: pointer;
            box-shadow: 0 1px 2px rgba(0,0,0,0.02);
        }

        .grid-card i { font-size: 30px; }
        .icon-teal { color: #0eb4c2; }
        .icon-gold { color: #facc15; }

        .gimtel-badge-match {
            width: 44px;
            height: 44px;
            background-color: #0eb4c2;
            color: #ffffff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 25px;
            font-weight: 700;
            font-family: Arial, sans-serif;
        }

        .grid-card span {
            font-size: 12.5px;
            font-weight: 600;
            line-height: 1.3;
            color: #374151;
        }

        .bottom-nav {
            background-color: #ffffff;
            border-top: 1px solid #e5e7eb;
            display: flex;
            justify-content: space-around;
            padding: 8px 0 6px;
            margin-top: auto;
        }

        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-decoration: none;
            color: #9ca3af;
            font-size: 11.5px;
            gap: 4px;
            font-weight: 600;
        }
        .nav-item i { font-size: 19px; }
        .nav-item.active { color: #0eb4c2; }

        /* ================= الواجهة 2: تحويل الأموال ================= */
        .action-buttons-top {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-top: 10px;
        }

        .top-btn {
            background-color: #007b8a;
            border: none;
            border-radius: 2px;
            padding: 20px 10px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 12px;
            color: #ffffff;
            cursor: pointer;
        }
        .top-btn.yellow {
            background-color: #fbc02d;
            color: #ffffff;
        }
        .top-btn svg {
            height: 30px;
            width: auto;
        }
        .top-btn span { font-size: 14px; font-weight: 600; }

        .grey-divider-bar {
            background-color: #eeeeee;
            padding: 10px;
            text-align: center;
            font-size: 14.5px;
            font-weight: 600;
            color: #4b5563;
        }

        .qr-center-box {
            padding: 28px 15px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 10px;
            background-color: #ffffff;
            cursor: pointer;
        }
        .qr-center-box i {
            font-size: 40px;
            color: #0eb4c2;
        }
        .qr-center-box span {
            font-size: 14px;
            font-weight: 600;
            color: #374151;
        }

        .board-section {
            padding: 22px 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            background-color: #ffffff;
            flex-grow: 1;
        }
        .board-desc {
            font-size: 13px;
            color: #6b7280;
            text-align: center;
            margin-bottom: 25px;
        }
        .add-board-box {
            width: 145px;
            height: 135px;
            border: 2.5px dotted #0eb4c2;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }
        .add-board-box i {
            font-size: 38px;
            color: #0eb4c2;
            font-weight: 300;
        }

        /* ================= الواجهة 3: إرسال الأموال ================= */
        .top-tabs {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            text-align: center;
            margin-top: 15px;
        }
        .tab-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            color: #ffffff;
            gap: 8px;
            opacity: 0.65;
            padding-bottom: 10px;
            cursor: pointer;
            position: relative;
        }
        .tab-item.active {
            opacity: 1;
        }
        .tab-item.active::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 10%;
            right: 10%;
            height: 3px;
            background-color: #ffffff;
        }
        .tab-icon-wrap {
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
        }
        .tab-item span {
            font-size: 11.5px;
            font-weight: 600;
        }

        .form-content {
            padding: 25px 20px;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            gap: 25px;
            background-color: #ffffff;
        }

        .clean-input-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        .clean-label {
            font-size: 14px;
            font-weight: 700;
            color: #374151;
            text-align: right;
        }
        .clean-input-row {
            display: flex;
            align-items: center;
            border-bottom: 1.5px solid #9ca3af;
            padding-bottom: 8px;
        }
        .clean-input {
            border: none;
            outline: none;
            width: 100%;
            font-size: 16px;
            color: #111315;
            background: transparent;
            text-align: right;
        }
        .clean-input::placeholder {
            color: #9ca3af;
            font-size: 15px;
        }
        .contacts-book-icon {
            color: #fbc02d;
            font-size: 22px;
            padding-right: 10px;
            cursor: pointer;
        }

        .bottom-full-btn {
            width: 100%;
            background-color: #fbc02d;
            color: #ffffff;
            border: none;
            padding: 15px;
            font-size: 17px;
            font-weight: 600;
            cursor: pointer;
            text-align: center;
            margin-top: auto;
        }

        /* ================= الواجهة 4: تأكيد تحويل الأموال ================= */
        .review-subtitle {
            text-align: right;
            padding: 18px 20px 10px;
            font-size: 15px;
            font-weight: 700;
            color: #374151;
        }

        .recipient-row {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 10px;
            padding: 5px 20px 18px;
            direction: ltr;
        }
        .recipient-number {
            font-size: 18px;
            font-weight: 700;
            color: #1f2937;
            letter-spacing: 0.5px;
        }
        .recipient-phone-icon-match {
            font-size: 22px;
            color: #4b5563;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .review-box-card {
            background-color: #f3f4f6;
            margin: 0 15px;
            border-radius: 6px;
            padding: 18px;
        }
        .review-amount-section {
            border-bottom: 1px solid #e5e7eb;
            padding-bottom: 14px;
            margin-bottom: 14px;
            text-align: right;
        }
        .review-amount-label {
            font-size: 14px;
            font-weight: 700;
            color: #374151;
            margin-bottom: 6px;
        }
        .review-amount-val {
            font-size: 16px;
            font-weight: 700;
            color: #111315;
            direction: ltr;
            text-align: right;
        }

        .fee-details-title {
            font-size: 14px;
            font-weight: 700;
            color: #374151;
            margin-bottom: 14px;
            text-align: right;
        }

        .fee-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 0;
            font-size: 14.5px;
            color: #374151;
            font-weight: 600;
        }
        .fee-dash {
            color: #6b7280;
        }
        .fee-val {
            direction: ltr;
            font-weight: 700;
            color: #1f2937;
        }

        /* ================= النوافذ المنبثقة ================= */
        .modal-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background-color: rgba(0, 0, 0, 0.45);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 1000;
        }

        .error-box {
            background-color: #ffffff;
            width: 82%;
            max-width: 310px;
            border-radius: 4px;
            overflow: hidden;
            text-align: center;
            box-shadow: 0 4px 20px rgba(0,0,0,0.2);
        }
        .error-title {
            font-size: 16px;
            font-weight: 700;
            padding: 18px 15px 8px;
            color: #111315;
        }
        .error-msg {
            font-size: 14px;
            color: #4b5563;
            padding: 0 15px 20px;
        }
        .modal-cyan-btn {
            background-color: #0eb4c2;
            color: #ffffff;
            border: none;
            width: 100%;
            padding: 14px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            display: block;
        }

        .pin-box {
            background-color: #ffffff;
            width: 85%;
            max-width: 320px;
            border-radius: 4px;
            overflow: hidden;
            position: relative;
            text-align: center;
            box-shadow: 0 6px 25px rgba(0,0,0,0.25);
        }
        .pin-close-btn {
            position: absolute;
            top: 10px;
            left: 12px;
            font-size: 22px;
            color: #9ca3af;
            cursor: pointer;
            line-height: 1;
        }
        .pin-prompt-text {
            font-size: 16px;
            font-weight: 600;
            color: #374151;
            margin: 42px 15px 30px;
        }
        .pin-slots {
            display: flex;
            justify-content: center;
            gap: 16px;
            margin-bottom: 35px;
            direction: ltr;
            cursor: pointer;
        }
        .pin-slot {
            width: 36px;
            height: 28px;
            border-bottom: 1.5px solid #374151;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 26px;
            color: #111315;
        }

        .receipt-box {
            background-color: #ffffff;
            width: 86%;
            max-width: 335px;
            border-radius: 6px;
            overflow: hidden;
            text-align: center;
            box-shadow: 0 8px 30px rgba(0,0,0,0.3);
        }
        .receipt-body {
            padding: 22px 18px 18px;
        }
        .receipt-title {
            font-size: 17px;
            font-weight: 700;
            color: #1f2937;
            margin-bottom: 16px;
        }
        .receipt-check-circle {
            width: 68px;
            height: 68px;
            border: 4px solid #4caf50;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            color: #4caf50;
            font-size: 32px;
        }
        .receipt-summary {
            font-size: 14.5px;
            font-weight: 700;
            color: #1f2937;
            line-height: 1.6;
            margin-bottom: 18px;
            direction: rtl;
        }
        .receipt-info-line {
            font-size: 13.5px;
            font-weight: 700;
            color: #1f2937;
            margin-bottom: 8px;
            direction: rtl;
        }
        .receipt-fav-row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            margin-top: 22px;
            padding-top: 6px;
            font-size: 14px;
            font-weight: 600;
            color: #4b5563;
            cursor: pointer;
        }
        .receipt-fav-row i {
            font-size: 26px;
            color: #9ca3af;
            transition: color 0.2s;
        }
        .receipt-fav-row i.starred {
            color: #fbc02d;
        }
    </style>
</head>
<body>

    <!-- ================= الواجهة 1: لوحة القيادة ================= -->
    <div id="page1" class="page active">
        <header class="top-header">
            <div class="navbar">
                <i class="fa-solid fa-bars menu-icon"></i>
                <h1 class="page-title">لوحة القيادة</h1>
            </div>
            <div class="top-actions">
                <!-- 1. تسديد مشتريات (على اليمين) -->
                <div class="action-item">
                    <div class="circle-icon-match">
                        <svg viewBox="0 0 36 36" width="30" height="30" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="7" y="6" width="16" height="22" rx="2" stroke="#ffffff" stroke-width="1.8"/>
                            <path d="M15 12H19M15 16H19" stroke="#ffffff" stroke-width="1.5" stroke-linecap="round"/>
                            <circle cx="15" cy="21" r="2.5" stroke="#ffffff" stroke-width="1.5"/>
                            <path d="M12 4H24C25.1 4 26 4.9 26 6V24" stroke="#ffffff" stroke-width="1.5" opacity="0.7"/>
                            <path d="M11 20H21C22.1 20 23 20.9 23 22V28C23 29.1 22.1 30 21 30H11C9.9 30 9 29.1 9 28V22C9 20.9 9.9 20 11 20Z" stroke="#ffffff" stroke-width="1.8" fill="#0ab2bf"/>
                            <path d="M13 24H19M13 26H17" stroke="#ffffff" stroke-width="1.5" stroke-linecap="round"/>
                        </svg>
                    </div>
                    <span>تسديد مشتريات</span>
                </div>

                <!-- 2. تحويل الأموال (في المنتصف) -->
                <div class="action-item" onclick="showPage('page2')">
                    <div class="circle-icon-match">
                        <svg viewBox="0 0 36 36" width="28" height="28" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M6 10H26C27.1 10 28 10.9 28 12V24C28 25.1 27.1 26 26 26H6C4.9 26 4 25.1 4 24V12C4 10.9 4.9 10 6 10Z" stroke="#ffffff" stroke-width="1.8"/>
                            <circle cx="16" cy="18" r="3" stroke="#ffffff" stroke-width="1.6"/>
                            <path d="M14 26L9 21L14 16" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                            <line x1="9" y1="21" x2="22" y2="21" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round"/>
                        </svg>
                    </div>
                    <span>تحويل الأموال</span>
                </div>

                <!-- 3. حسابي (على اليسار) -->
                <div class="action-item">
                    <div class="circle-icon-match">
                        <svg viewBox="0 0 36 36" width="28" height="28" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <rect x="9" y="5" width="18" height="26" rx="2" stroke="#ffffff" stroke-width="1.8"/>
                            <line x1="13" y1="10" x2="23" y2="10" stroke="#ffffff" stroke-width="1.5" stroke-linecap="round"/>
                            <line x1="13" y1="15" x2="23" y2="15" stroke="#ffffff" stroke-width="1.5" stroke-linecap="round"/>
                            <line x1="13" y1="20" x2="18" y2="20" stroke="#ffffff" stroke-width="1.5" stroke-linecap="round"/>
                            <path d="M19 23L22 26L27 21" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </div>
                    <span>حسابي</span>
                </div>
            </div>
        </header>

        <main class="dashboard-grid">
            <!-- 1. تعبئة رصيد الهاتف -->
            <div class="grid-card">
                <svg viewBox="0 0 40 44" width="38" height="42" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="8" y="3" width="24" height="38" rx="3" stroke="#0eb4c2" stroke-width="2"/>
                    <line x1="17" y1="6.5" x2="23" y2="6.5" stroke="#0eb4c2" stroke-width="1.8" stroke-linecap="round"/>
                    <rect x="11.5" y="10" width="17" height="23.5" stroke="#0eb4c2" stroke-width="1.6"/>
                    <circle cx="20" cy="37.2" r="1.3" fill="#0eb4c2"/>
                    <path d="M20 14L26 20.5H22.6V28.5H17.4V20.5H14L20 14Z" stroke="#0eb4c2" stroke-width="1.7" stroke-linejoin="round"/>
                </svg>
                <span>تعبئة رصيد الهاتف</span>
            </div>
            <!-- 2. تسديد الفواتير -->
            <div class="grid-card">
                <svg viewBox="0 0 44 44" width="40" height="40" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M11 5H30V31H11" stroke="#facc15" stroke-width="2" stroke-linejoin="round"/>
                    <path d="M11 5V21" stroke="#facc15" stroke-width="2" stroke-linecap="round"/>
                    <rect x="14.5" y="9" width="12" height="4.5" stroke="#facc15" stroke-width="1.7"/>
                    <line x1="19" y1="17.5" x2="26.5" y2="17.5" stroke="#facc15" stroke-width="1.7" stroke-linecap="round"/>
                    <line x1="19" y1="21" x2="26.5" y2="21" stroke="#facc15" stroke-width="1.7" stroke-linecap="round"/>
                    <line x1="19" y1="24.5" x2="26.5" y2="24.5" stroke="#facc15" stroke-width="1.7" stroke-linecap="round"/>
                    <line x1="15" y1="17.5" x2="16.2" y2="17.5" stroke="#facc15" stroke-width="1.8" stroke-linecap="round"/>
                    <line x1="15" y1="21" x2="16.2" y2="21" stroke="#facc15" stroke-width="1.8" stroke-linecap="round"/>
                    <line x1="15" y1="24.5" x2="16.2" y2="24.5" stroke="#facc15" stroke-width="1.8" stroke-linecap="round"/>
                    <path d="M30 18H36V27.5C36 29.5 34.5 31 32.5 31H29" stroke="#facc15" stroke-width="2" stroke-linejoin="round"/>
                    <path d="M11 20C8.5 21.5 7 24 7 27V38" stroke="#facc15" stroke-width="2" stroke-linecap="round"/>
                    <path d="M11 24.5L13.5 23.5C14.8 23 15.8 24.3 14.8 25.5L11.5 28.5" stroke="#facc15" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M16 31V35.5C16 36.8 15 38 13.5 38" stroke="#facc15" stroke-width="2" stroke-linecap="round"/>
                </svg>
                <span>تسديد الفواتير</span>
            </div>
            <!-- 3. طلب دفتر شيكات -->
            <div class="grid-card">
                <svg viewBox="0 0 46 42" width="44" height="40" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="8.5" y="7" width="3.6" height="22" rx="1" stroke="#0eb4c2" stroke-width="1.9"/>
                    <path d="M10.3 4.5V7" stroke="#0eb4c2" stroke-width="1.9" stroke-linecap="round"/>
                    <path d="M8.5 29L10.3 33.5L12.1 29" stroke="#0eb4c2" stroke-width="1.9" stroke-linejoin="round"/>
                    <path d="M12.1 10.5H14.2V18.5" stroke="#0eb4c2" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M6 12H8.5" stroke="#0eb4c2" stroke-width="1.9" stroke-linecap="round"/>
                    <path d="M6 12V28" stroke="#0eb4c2" stroke-width="1.9" stroke-linecap="round"/>
                    <path d="M14.2 12H36.5" stroke="#0eb4c2" stroke-width="1.9" stroke-linecap="round"/>
                    <path d="M36.5 12C39 12 40.5 13.5 40.5 16V29C40.5 31.2 38.8 33 36.5 33H6" stroke="#0eb4c2" stroke-width="1.9" stroke-linecap="round"/>
                    <path d="M36.5 12V25.5" stroke="#0eb4c2" stroke-width="1.9" stroke-linecap="round"/>
                    <path d="M13 25.5H37.5C39.2 25.5 40.5 26.8 40.5 28.5" stroke="#0eb4c2" stroke-width="1.9" stroke-linecap="round"/>
                    <path d="M13 29.2H37.5" stroke="#0eb4c2" stroke-width="1.8" stroke-linecap="round"/>
                    <line x1="6" y1="25.5" x2="8.5" y2="25.5" stroke="#0eb4c2" stroke-width="1.9" stroke-linecap="round"/>
