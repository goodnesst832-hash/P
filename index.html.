<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تطبيق تحويل الأموال</title>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Cairo', sans-serif;
        }

        body {
            background-color: #f3f4f6;
            color: #111315;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            max-width: 480px;
            margin: 0 auto;
            border-left: 1px solid #e5e7eb;
            border-right: 1px solid #e5e7eb;
            position: relative;
        }

        .page {
            display: none;
            flex-direction: column;
            min-height: 100vh;
            background-color: #ffffff;
        }

        .page.active {
            display: flex;
        }

        /* الهيدر العلوي */
        .top-header {
            background-color: #0eb4c2;
            padding: 16px 18px 22px;
            color: #ffffff;
        }

        .navbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
            position: relative;
        }

        .menu-icon, .back-icon {
            font-size: 22px;
            color: #ffffff;
            cursor: pointer;
            z-index: 2;
        }

        .page-title {
            font-size: 19px;
            font-weight: 600;
            position: absolute;
            left: 0;
            right: 0;
            text-align: center;
            pointer-events: none;
        }

        /* ================= الواجهة 1: لوحة القيادة ================= */
        .top-actions {
            display: flex;
            justify-content: space-around;
            align-items: center;
            text-align: center;
            padding-top: 5px;
        }

        .action-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            color: #ffffff;
            gap: 8px;
            cursor: pointer;
            width: 33.3%;
        }

        .circle-icon {
            width: 56px;
            height: 56px;
            background-color: #0a8d99;
            border: 1.5px solid #c5e063;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
        }

        .action-item span {
            font-size: 13px;
            font-weight: 600;
        }

        .dashboard-grid {
            padding: 14px;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            flex-grow: 1;
            align-content: start;
            background-color: #ffffff;
        }

        .grid-card {
            background-color: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 3px;
            padding: 20px 6px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: #1f2937;
            gap: 12px;
            min-height: 120px;
            cursor: pointer;
            box-shadow: 0 1px 2px rgba(0,0,0,0.02);
        }

        .grid-card i { font-size: 30px; }
        .icon-teal { color: #0eb4c2; }
        .icon-gold { color: #facc15; }

        .gimtel-badge {
            width: 44px;
            height: 44px;
            background-color: #0eb4c2;
            color: #ffffff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            font-weight: 700;
        }

        .grid-card span {
            font-size: 12.5px;
            font-weight: 600;
            line-height: 1.3;
            color: #374151;
        }

        .bottom-nav {
            background-color: #ffffff;
            border-top: 1px solid #e5e7eb;
            display: flex;
            justify-content: space-around;
            padding: 8px 0 6px;
            margin-top: auto;
        }

        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-decoration: none;
            color: #9ca3af;
            font-size: 11.5px;
            gap: 4px;
            font-weight: 600;
        }
        .nav-item i { font-size: 19px; }
        .nav-item.active { color: #0eb4c2; }

        /* ================= الواجهة 2: تحويل الأموال ================= */
        .action-buttons-top {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-top: 10px;
        }

        .top-btn {
            background-color: #007b8a;
            border: none;
            border-radius: 2px;
            padding: 15px 10px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 8px;
            color: #ffffff;
            cursor: pointer;
        }
        .top-btn.yellow {
            background-color: #fbc02d;
            color: #ffffff;
        }
        
        /* تنسيق صورة إرسال الأموال المعتمدة على Base64 داخل الزر العلوي */
        .send-money-custom-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
        }
        .send-money-custom-img {
            width: 85px;
            height: auto;
            display: block;
        }
        .send-money-custom-text {
            color: #FFFFFF;
            font-size: 14px;
            font-weight: 600;
        }

        .top-btn i { font-size: 26px; }
        .top-btn span { font-size: 14px; font-weight: 600; }

        .grey-divider-bar {
            background-color: #eeeeee;
            padding: 10px;
            text-align: center;
            font-size: 14.5px;
            font-weight: 600;
            color: #4b5563;
        }

        .qr-center-box {
            padding: 28px 15px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 10px;
            background-color: #ffffff;
            cursor: pointer;
        }
        .qr-center-box i {
            font-size: 40px;
            color: #0eb4c2;
        }
        .qr-center-box span {
            font-size: 14px;
            font-weight: 600;
            color: #374151;
        }

        .board-section {
            padding: 22px 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            background-color: #ffffff;
            flex-grow: 1;
        }
        .board-desc {
            font-size: 13px;
            color: #6b7280;
            text-align: center;
            margin-bottom: 25px;
        }
        .add-board-box {
            width: 145px;
            height: 135px;
            border: 2.5px dotted #0eb4c2;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
        }
        .add-board-box i {
            font-size: 38px;
            color: #0eb4c2;
            font-weight: 300;
        }

        /* ================= الواجهة 3: إرسال الأموال ================= */
        .top-tabs {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            text-align: center;
            margin-top: 15px;
        }
        .tab-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            color: #ffffff;
            gap: 8px;
            opacity: 0.65;
            padding-bottom: 10px;
            cursor: pointer;
            position: relative;
        }
        .tab-item.active {
            opacity: 1;
        }
        .tab-item.active::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 10%;
            right: 10%;
            height: 3px;
            background-color: #ffffff;
        }
        .tab-icon-wrap {
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
        }
        .tab-item span {
            font-size: 11.5px;
            font-weight: 600;
        }

        .form-content {
            padding: 25px 20px;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            gap: 25px;
            background-color: #ffffff;
        }

        .clean-input-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        .clean-label {
            font-size: 14px;
            font-weight: 700;
            color: #374151;
            text-align: right;
        }
        .clean-input-row {
            display: flex;
            align-items: center;
            border-bottom: 1.5px solid #9ca3af;
            padding-bottom: 8px;
        }
        .clean-input {
            border: none;
            outline: none;
            width: 100%;
            font-size: 16px;
            color: #111315;
            background: transparent;
            text-align: right;
        }
        .clean-input::placeholder {
            color: #9ca3af;
            font-size: 15px;
        }
        .contacts-book-icon {
            color: #fbc02d;
            font-size: 22px;
            padding-right: 10px;
            cursor: pointer;
        }

        .bottom-full-btn {
            width: 100%;
            background-color: #fbc02d;
            color: #ffffff;
            border: none;
            padding: 15px;
            font-size: 17px;
            font-weight: 600;
            cursor: pointer;
            text-align: center;
            margin-top: auto;
        }

        /* ================= الواجهة 4: تأكيد تحويل الأموال ================= */
        .review-subtitle {
            text-align: right;
            padding: 18px 20px 10px;
            font-size: 15px;
            font-weight: 700;
            color: #374151;
        }

        .recipient-row {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 12px;
            padding: 5px 20px 18px;
        }
        .recipient-number {
            font-size: 17px;
            font-weight: 700;
            color: #1f2937;
            letter-spacing: 0.5px;
        }
        .recipient-phone-circle {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background-color: #4b5563;
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .review-box-card {
            background-color: #f3f4f6;
            margin: 0 15px;
            border-radius: 6px;
            padding: 18px;
        }
        .review-amount-section {
            border-bottom: 1px solid #e5e7eb;
            padding-bottom: 14px;
            margin-bottom: 14px;
            text-align: right;
        }
        .review-amount-label {
            font-size: 14px;
            font-weight: 700;
            color: #374151;
            margin-bottom: 6px;
        }
        .review-amount-val {
            font-size: 16px;
            font-weight: 700;
            color: #111315;
            direction: ltr;
            text-align: right;
        }

        .fee-details-title {
            font-size: 14px;
            font-weight: 700;
            color: #374151;
            margin-bottom: 14px;
            text-align: right;
        }

        .fee-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 0;
            font-size: 14.5px;
            color: #374151;
            font-weight: 600;
        }
        .fee-dash {
            color: #6b7280;
        }
        .fee-val {
            direction: ltr;
            font-weight: 700;
            color: #1f2937;
        }

        /* ================= النوافذ المنبثقة ================= */
        .modal-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background-color: rgba(0, 0, 0, 0.45);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 1000;
        }

        .error-box {
            background-color: #ffffff;
            width: 82%;
            max-width: 310px;
            border-radius: 4px;
            overflow: hidden;
            text-align: center;
            box-shadow: 0 4px 20px rgba(0,0,0,0.2);
        }
        .error-title {
            font-size: 16px;
            font-weight: 700;
            padding: 18px 15px 8px;
            color: #111315;
        }
        .error-msg {
            font-size: 14px;
            color: #4b5563;
            padding: 0 15px 20px;
        }
        .modal-cyan-btn {
            background-color: #0eb4c2;
            color: #ffffff;
            border: none;
            width: 100%;
            padding: 14px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            display: block;
        }

        .pin-box {
            background-color: #ffffff;
            width: 85%;
            max-width: 320px;
            border-radius: 4px;
            overflow: hidden;
            position: relative;
            text-align: center;
            box-shadow: 0 6px 25px rgba(0,0,0,0.25);
        }
        .pin-close-btn {
            position: absolute;
            top: 10px;
            left: 12px;
            font-size: 22px;
            color: #9ca3af;
            cursor: pointer;
            line-height: 1;
        }
        .pin-prompt-text {
            font-size: 16px;
            font-weight: 600;
            color: #374151;
            margin: 42px 15px 30px;
        }
        .pin-slots {
            display: flex;
            justify-content: center;
            gap: 16px;
            margin-bottom: 35px;
            direction: ltr;
            cursor: pointer;
        }
        .pin-slot {
            width: 36px;
            height: 28px;
            border-bottom: 1.5px solid #374151;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 26px;
            color: #111315;
        }

        .receipt-box {
            background-color: #ffffff;
            width: 86%;
            max-width: 335px;
            border-radius: 6px;
            overflow: hidden;
            text-align: center;
            box-shadow: 0 8px 30px rgba(0,0,0,0.3);
        }
        .receipt-body {
            padding: 22px 18px 18px;
        }
        .receipt-title {
            font-size: 17px;
            font-weight: 700;
            color: #1f2937;
            margin-bottom: 16px;
        }
        .receipt-check-circle {
            width: 68px;
            height: 68px;
            border: 4px solid #4caf50;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            color: #4caf50;
            font-size: 32px;
        }
        .receipt-summary {
            font-size: 14.5px;
            font-weight: 700;
            color: #1f2937;
            line-height: 1.6;
            margin-bottom: 18px;
        }
        .receipt-info-line {
            font-size: 13.5px;
            font-weight: 700;
            color: #1f2937;
            margin-bottom: 8px;
            direction: rtl;
        }
        .receipt-fav-row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            margin-top: 22px;
            padding-top: 6px;
            font-size: 14px;
            font-weight: 600;
            color: #4b5563;
            cursor: pointer;
        }
        .receipt-fav-row i {
            font-size: 26px;
            color: #9ca3af;
            transition: color 0.2s;
        }
        .receipt-fav-row i.starred {
            color: #fbc02d;
        }
    </style>
</head>
<body>

    <!-- ================= الواجهة 1: لوحة القيادة ================= -->
    <div id="page1" class="page active">
        <header class="top-header">
            <div class="navbar">
                <i class="fa-solid fa-bars menu-icon"></i>
                <h1 class="page-title">لوحة القيادة</h1>
            </div>
            <div class="top-actions">
                <div class="action-item">
                    <div class="circle-icon"><i class="fa-solid fa-hand-holding-dollar"></i></div>
                    <span>تسديد مشتريات</span>
                </div>
                <div class="action-item" onclick="showPage('page2')">
                    <div class="circle-icon"><i class="fa-solid fa-money-bill-transfer"></i></div>
                    <span>تحويل الأموال</span>
                </div>
                <div class="action-item">
                    <div class="circle-icon"><i class="fa-solid fa-file-invoice"></i></div>
                    <span>حسابي</span>
                </div>
            </div>
        </header>

        <main class="dashboard-grid">
            <div class="grid-card"><i class="fa-solid fa-mobile-screen-button icon-teal"></i><span>تعبئة رصيد الهاتف</span></div>
            <div class="grid-card"><i class="fa-solid fa-file-invoice-dollar icon-gold"></i><span>تسديد الفواتير</span></div>
            <div class="grid-card"><i class="fa-solid fa-money-check-dollar icon-teal"></i><span>طلب دفتر شيكات</span></div>
            <div class="grid-card"><i class="fa-regular fa-credit-card icon-gold"></i><span>البطاقات البنكية</span></div>
            <div class="grid-card"><i class="fa-solid fa-money-bill-wave icon-teal"></i><span>سحب النقود</span></div>
            <div class="grid-card"><i class="fa-solid fa-mobile-retro icon-gold"></i><span>ب-باي</span></div>
            <div class="grid-card"><div class="gimtel-badge">G</div><span>جيمتل</span></div>
        </main>

        <nav class="bottom-nav">
            <a href="#" class="nav-item active"><i class="fa-solid fa-house"></i><span>الرئيسية</span></a>
            <a href="#" class="nav-item"><i class="fa-regular fa-star"></i><span>المفضلة</span></a>
            <a href="#" class="nav-item"><i class="fa-regular fa-bell"></i><span>الإشعارات</span></a>
            <a href="#" class="nav-item"><i class="fa-regular fa-circle-question"></i><span>المساعدة</span></a>
        </nav>
    </div>

    <!-- ================= الواجهة 2: تحويل الأموال (مزودة بالصورة الصحيحة لإرسال الأموال) ================= -->
    <div id="page2" class="page">
        <header class="top-header" style="padding-bottom: 16px;">
            <div class="navbar">
                <i class="fa-solid fa-arrow-right back-icon" onclick="showPage('page1')"></i>
                <h1 class="page-title">تحويل الأموال</h1>
            </div>
            <div class="action-buttons-top">
                <button class="top-btn yellow">
                    <i class="fa-solid fa-hand-holding-dollar"></i>
                    <span>طلب المال</span>
                </button>
                <button class="top-btn" onclick="openSendMoneyPage()">
                    <div class="send-money-custom-container">
                        <img class="send-money-custom-img" src="data:image/jpeg;base64,
