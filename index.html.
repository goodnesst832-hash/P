                    </div>
                    <span>رقم الهاتف</span>
                </div>
                <!-- 2. اسم المستخدم -->
                <div class="tab-item">
                    <div class="tab-icon-wrap">
                        <svg viewBox="0 0 32 32" width="22" height="22" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M16 6C13.2 6 11 8.2 11 11C11 13.8 13.2 16 16 16C18.8 16 21 13.8 21 11C21 8.2 18.8 6 16 6ZM8 24C8 20.5 11.6 18 16 18C20.4 18 24 20.5 24 24V25H8V24Z" fill="#ffffff"/>
                        </svg>
                    </div>
                    <span>اسم المستخدم</span>
                </div>
                <!-- 3. بنك -->
                <div class="tab-item">
                    <div class="tab-icon-wrap">
                        <svg viewBox="0 0 32 32" width="24" height="22" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M4 28H28M2 24H30M16 4L28 10H4L16 4Z" stroke="#ffffff" stroke-width="2" stroke-linejoin="round"/>
                            <path d="M8 14V22M16 14V22M24 14V22" stroke="#ffffff" stroke-width="2" stroke-linecap="round"/>
                        </svg>
                    </div>
                    <span>بنك</span>
                </div>
                <!-- 4. فيسبوك -->
                <div class="tab-item">
                    <div class="tab-icon-wrap">
                        <svg viewBox="0 0 32 32" width="22" height="22" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <circle cx="16" cy="16" r="15" fill="#ffffff"/>
                            <path d="M18.5 17.5H21V13.5H18.5V11.5C18.5 10.7 18.9 10.5 19.5 10.5H21V6.5H18.5C16 6.5 14.5 8 14.5 10.5V13.5H12V17.5H14.5V25H18.5V17.5Z" fill="#0eb4c2"/>
